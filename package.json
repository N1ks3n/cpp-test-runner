{
  "name": "cpp-test-runner",
  "version": "1.0.0",
  "description": "Расширение для Visual Studio Code, которое запускает тесты CMake/CTest одной кнопкой.",
  "main": "./dist/extension.js",
  "displayName": "C++ Test Runner",
  "engines": {
    "vscode": "^1.96.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "cppTestRunner.runTests",
        "title": "C++ Test Runner: Run Tests"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N1ks3n/cpp-test-runner.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/N1ks3n/cpp-test-runner/issues"
  },
  "homepage": "https://github.com/N1ks3n/cpp-test-runner#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.145.0",
    "typescript": "^7.0.2"
  }
}
