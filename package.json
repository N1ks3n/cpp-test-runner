{
  "name": "cpp-test-runner",
  "version": "1.0.0",
  "description": "Расширение для Visual Studio Code, которое запускает тесты CMake/CTest одной кнопкой.",
  "main": "./dist/extension.js",
  "displayName": "C++ Test Runner",
  "engines": {
    "vscode": "^1.96.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "cppTestRunner.runTests",
        "title": "C++ Test Runner: Run Tests"
      },
      {
        "command": "cppTestRunner.openSettings",
        "title": "C++ Test Runner: Open Settings"
      },
      {
        "command": "cppTestRunner.showStatistics",
        "title": "C++ Test Runner: Show Statistics"
      }
    ],
    "configuration": {
      "title": "C++ Test Runner",
      "properties": {
        "cppTestRunner.logs.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Сохранять логи запусков в файлы.",
          "scope": "resource"
        },
        "cppTestRunner.logs.directory": {
          "type": "string",
          "default": "",
          "description": "Папка для логов: абсолютный путь или путь относительно открытого C++ проекта.",
          "scope": "resource"
        },
        "cppTestRunner.tests.parallelJobs": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "description": "Максимальное число одновременно выполняемых тестов.",
          "scope": "resource"
        },
        "cppTestRunner.tests.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "exclusiveMinimum": 0,
          "description": "Тайм-аут одного теста в секундах. TIMEOUT конкретного теста из CMake имеет приоритет.",
          "scope": "resource"
        },
        "cppTestRunner.statistics.historyLimit": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "description": "Максимальное число сохранённых запусков для каждого проекта.",
          "scope": "resource"
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N1ks3n/cpp-test-runner.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/N1ks3n/cpp-test-runner/issues"
  },
  "homepage": "https://github.com/N1ks3n/cpp-test-runner#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0"
  }
}
